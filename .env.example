# opcionális – nélkülük is fut (claude-cli / ollama / szabályalapú címkézés)
# ANTHROPIC_API_KEY=sk-ant-...
# RADAR_MODEL=claude-opus-5
# RADAR_LLM=api|cli|ollama|rules      # háttér kényszerítése
# OLLAMA_MODEL=llama3.1
# MODASH_API_KEY=...                  # fizetős Discovery API
# BRAVE_SEARCH_API_KEY=BSA...      # hivatalos webkeresés-API a felderítéshez (ingyenes sáv: 2000 lekérdezés/hó); nélküle DuckDuckGo
